__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

.env
.venv/
env/
venv/

*.aux.xml
*.ovr
*.cpg
*.qix
*.sbn
*.sbx
*.lock

outputs/logs/*.log

# Keep raw source data local unless a small sample is intentionally added.
data/raw/**/*
!data/raw/**/.gitkeep

# Raster products are heavy and should not be committed to Git/Streamlit Cloud.
*.tif
*.tiff
*.img
*.vrt
*.bil
*.bip
*.bsq
*.adf
*.grd

# This project deploys the Ilaje dashboard with its generated analysis rasters.
# Keep the ignore default above, then explicitly upload only the current study-area products.
!data/raw/lulc/
!data/raw/lulc/lulc.tif
!data/raw/outlets/
!data/raw/outlets/*.gpkg
!data/interim/**/*.tif
!data/interim/**/*.gpkg
!data/processed/rasters/**/*.tif

# Allow lightweight dashboard/report artifacts and vector outputs.
!outputs/**/*.png
!outputs/**/*.jpg
!outputs/**/*.jpeg
!outputs/**/*.svg
!outputs/**/*.html
!outputs/**/*.md
!data/interim/**/.gitkeep
!data/processed/**/.gitkeep
!data/processed/dashboard_layers/**/*.json
!data/processed/**/*.gpkg
!data/processed/**/*.geojson
!data/processed/**/*.csv
!data/processed/**/*.png
!data/processed/**/*.jpg
!data/processed/**/*.jpeg
!data/processed/**/*.svg

# Shapefiles are many sidecar files; prefer GeoPackage for uploadable dashboard layers.
data/**/*.shp
data/**/*.shx
data/**/*.dbf
data/**/*.prj
